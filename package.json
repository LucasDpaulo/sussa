{
  "name": "sussa",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.mjs",
    "start": "node server.mjs",
    "test": "node --test",
    "desktop": "electron .",
    "pack:linux": "electron-builder --linux AppImage deb --publish never",
    "pack:windows": "electron-builder --win nsis --publish never",
    "test:desktop": "node scripts/desktop-smoke.mjs",
    "test:youtube": "electron scripts/youtube-smoke.cjs"
  },
  "main": "desktop/main.cjs",
  "description": "Pomodoro local para estudos e trabalho",
  "desktopName": "sussa.desktop",
  "author": "LucasDpaulo",
  "devDependencies": {
    "electron": "45.3.2",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "io.github.lucasdpaulo.sussa",
    "productName": "Sussa",
    "directories": {
      "output": "release"
    },
    "files": [
      "desktop/**",
      "src/**",
      "index.html",
      "assets/forest-trail.webp",
      "assets/surface-grain.svg",
      "package.json",
      "assets/design-1.png",
      "assets/audio/**",
      "assets/media-credits.json",
      "assets/icon.png"
    ],
    "appImage": {
      "artifactName": "sussa-${version}-${arch}.${ext}"
    },
    "linux": {
      "icon": "build/icons",
      "category": "Office",
      "executableName": "sussa",
      "maintainer": "LucasDpaulo",
      "syncDesktopName": true,
      "synopsis": "Pomodoro tranquilo para estudar e trabalhar"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "artifactName": "sussa-setup-${version}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
